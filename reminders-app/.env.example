# Token de la API de Todoist
# Se genera en: Todoist > Configuración > Integraciones > Desarrollador
TODOIST_API_TOKEN=

# Credenciales de iCloud para leer Reminders vía CalDAV
# La contraseña NO es tu contraseña de Apple ID normal: hay que generar una
# "contraseña específica de app" en https://appleid.apple.com (Seguridad > Contraseñas de apps)

# Opción A: una sola cuenta
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=

# Opción B: varias cuentas de iCloud a la vez (si se define, tiene prioridad
# sobre ICLOUD_APPLE_ID/ICLOUD_APP_PASSWORD). Formato: correo:contraseña,
# separadas por coma.
# ICLOUD_ACCOUNTS=personal@icloud.com:xxxx-xxxx-xxxx-xxxx,trabajo@icloud.com:yyyy-yyyy-yyyy-yyyy

# Puerto opcional del servidor local (por defecto 3000)
PORT=3000

# Login básico (usuario/contraseña) para proteger la app.
# En uso local no hace falta completarlo. SI la desplegás en un hosting
# público (Render, etc.), completá los dos para que no quede abierta a
# cualquiera que encuentre la URL.
APP_USERNAME=
APP_PASSWORD=

# Microsoft To Do (opcional). Requiere registrar una app en Entra ID
# (https://entra.microsoft.com > App registrations > New registration) con
# permisos delegados Tasks.ReadWrite y offline_access (ver README).
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Tenant ID de tu registro. Dejalo en blanco para usar "common" (cuentas
# personales y de cualquier organización).
MS_TENANT_ID=
# Debe coincidir EXACTO con el URI de redirección configurado en Entra ID.
MS_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
